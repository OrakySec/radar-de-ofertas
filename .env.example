# Variáveis de ambiente da stack (configure na tela da stack no Portainer,
# não neste arquivo — .env.example é só documentação, não é lido em produção).

# --- Links dos grupos (WhatsApp ou Telegram) ---
LINK_CASA=https://chat.whatsapp.com/xxxxxxxxxxxxx
LINK_INFORMATICA=https://chat.whatsapp.com/xxxxxxxxxxxxx
LINK_GAMES=https://t.me/xxxxxxxxxxxxx
LINK_IMPRESSAO3D=https://chat.whatsapp.com/xxxxxxxxxxxxx

# Impressão 3D com os DOIS canais: com WhatsApp e Telegram preenchidos, o botão
# "Entrar no grupo" abre um modal pra pessoa escolher onde entrar. Se só um
# dos dois estiver preenchido, vai direto nele; se nenhum, usa LINK_IMPRESSAO3D.
LINK_IMPRESSAO3D_WHATSAPP=https://chat.whatsapp.com/xxxxxxxxxxxxx
LINK_IMPRESSAO3D_TELEGRAM=https://t.me/+xxxxxxxxxxxxx

# --- Meta Pixel + Conversions API ---
# ID do Pixel (Events Manager > Fontes de dados). Mesmo valor nos dois
# serviços (app injeta no navegador, tracking-api usa na chamada server-side).
META_PIXEL_ID=1036050992396935
# Token do sistema, gerado em Events Manager > Configurações de eventos >
# Conversions API > Gerar token de acesso. NUNCA reutilize token de outro
# projeto/pixel, e nunca commite esse valor em lugar nenhum.
META_CAPI_TOKEN=

# --- Google Ads (opcional) ---
# Formato do ID de conversão do Google Ads: AW-XXXXXXXXX/XXXXXXXXX
# Separe as duas partes:
GOOGLE_ADS_ID=AW-XXXXXXXXX
GOOGLE_ADS_LABEL=XXXXXXXXX

# --- Bot do Telegram: conta as entradas do grupo e liga cada uma ao anúncio ---
# Passo-a-passo completo em tracking-api/README.md. Sem o token, o bot fica desligado.
# Token do bot (criado no @BotFather). O bot precisa ser ADMIN do grupo.
TELEGRAM_BOT_TOKEN=
# categoria:idDoGrupo (o id começa com -100; mande /chatid pro bot dentro do grupo).
# Categorias: casa, informatica, games, impressao3d. Vários separados por vírgula.
TELEGRAM_CHATS=impressao3d:-100XXXXXXXXXX
# Quem pode usar /stats (mande /id pro bot no privado). Vários separados por vírgula.
TELEGRAM_ADMIN_IDS=
# Só pra validar no Events Manager (aba "Eventos de teste"). Deixe VAZIO em produção.
META_TEST_EVENT_CODE=
