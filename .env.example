# Variáveis de ambiente da stack (configure na tela da stack no Portainer,
# não neste arquivo — .env.example é só documentação, não é lido em produção).

# --- Links dos grupos (WhatsApp ou Telegram) ---
LINK_CASA=https://chat.whatsapp.com/xxxxxxxxxxxxx
LINK_INFORMATICA=https://chat.whatsapp.com/xxxxxxxxxxxxx
LINK_GAMES=https://t.me/xxxxxxxxxxxxx
LINK_IMPRESSAO3D=https://chat.whatsapp.com/xxxxxxxxxxxxx

# --- Meta Pixel + Conversions API ---
# ID do Pixel (Events Manager > Fontes de dados). Mesmo valor nos dois
# serviços (app injeta no navegador, tracking-api usa na chamada server-side).
META_PIXEL_ID=1036050992396935
# Token do sistema, gerado em Events Manager > Configurações de eventos >
# Conversions API > Gerar token de acesso. NUNCA reutilize token de outro
# projeto/pixel, e nunca commite esse valor em lugar nenhum.
META_CAPI_TOKEN=

# --- Google Ads (opcional) ---
# Formato do ID de conversão do Google Ads: AW-XXXXXXXXX/XXXXXXXXX
# Separe as duas partes:
GOOGLE_ADS_ID=AW-XXXXXXXXX
GOOGLE_ADS_LABEL=XXXXXXXXX
